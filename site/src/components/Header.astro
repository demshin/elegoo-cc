---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Icon } from '@astrojs/starlight/components';

const community = config.social?.find(link => link.icon === 'telegram');
---

<div class="compact-header">
  <div class="brand"><SiteTitle /></div>
  <div class="search print:hidden"><Search /></div>
  {community && (
    <a class="community print:hidden" href={community.href} aria-label={community.label} title={community.label} target="_blank" rel="noopener noreferrer">
      <Icon name="telegram" size="1.15rem" />
      <span>Сообщество</span>
    </a>
  )}
  <div class="theme print:hidden"><ThemeSelect /></div>
</div>

<style>
  .compact-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }
  .brand { min-width: 0; }
  .brand :global(.site-title) { font-size: 1rem; line-height: 1.15; }
  .brand :global(.site-title span) { white-space: normal; }
  .search { flex: 1 1 24rem; max-width: 28rem; margin-inline-start: auto; min-width: 0; }
  .community {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: var(--sl-color-text-accent);
    font-size: .875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .community:hover { text-decoration: underline; }
  .community, .theme { flex-shrink: 0; }
  @media (max-width: 49.999rem) {
    .compact-header { gap: .65rem; }
    .brand :global(.site-title) { font-size: .875rem; }
    .search { flex: 0 0 auto; }
    .community span, .theme { display: none; }
  }
</style>
